# TaskPilot environment variables
#
# Copy this file to .env and fill in real values. Never commit .env itself.
# Each task adds the variables it needs; everything below Task 1 is a
# placeholder until that layer is built.

# ---- Task 1: client ----
# Base URL of the TaskPilot API. Left unset in Task 1, which runs on mock data.
VITE_API_URL=http://localhost:4000/api

# ---- Task 2: API server ----
PORT=4000
NODE_ENV=development

# ---- Task 3: database ----
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/taskpilot

# ---- Task 4: auth + AI ----
# Secret used to sign JWTs. Generate a long random string.
JWT_SECRET=replace-with-a-long-random-string
# Claude API key for the AI assignment planner. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...
