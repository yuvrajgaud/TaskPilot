# TaskPilot client — build-time environment
#
# Copy to .env for local overrides. Vite only exposes vars prefixed with VITE_,
# and inlines them at build time (so changing one needs a rebuild). Never commit
# a real .env.

# Base URL of the TaskPilot API. Defaults to the local server when unset.
# In production set this in your host's UI (not here) to the deployed API, e.g.
#   VITE_API_URL=https://taskpilot-api.onrender.com/api
VITE_API_URL=http://localhost:4000/api
