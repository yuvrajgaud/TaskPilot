# TaskPilot API — server environment
#
# Copy to .env and adjust. Task 2 runs with these defaults out of the box,
# so .env is optional until the database and AI layers arrive.
# Never commit .env — it is gitignored.

# ---- Task 2 ----
PORT=4000
NODE_ENV=development
# Origin(s) allowed by CORS, comma-separated. The Vite client runs here in
# development; in production set this to your deployed client origin, e.g.
#   CLIENT_URL=https://taskpilot.netlify.app
CLIENT_URL=http://localhost:5173

# ---- Task 3 (database) ----
# PostgreSQL connection string. Required from Task 3 onward.
# Local Postgres looks like the line below; a hosted Neon/Supabase URL looks
# like postgresql://user:pass@host/dbname?sslmode=require
# This is a placeholder — put your real value in .env, and never commit that.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/taskpilot
# Direct (non-pooled) connection, used only by `prisma migrate`. On a local
# database it is identical to DATABASE_URL. On a pooled host like Neon it is the
# same URL with "-pooler" removed from the host.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/taskpilot

# ---- Task 4 (auth) ----
# Secret used to sign and verify JWT auth tokens. Required from Task 4 onward.
# Generate a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Task 4 (AI planner) ----
# Google Gemini API key for the AI study planner. Get a free one at
# https://aistudio.google.com/apikey — the free tier needs no billing.
# Without it the server still runs; only POST /api/planner is disabled (503).
# GEMINI_API_KEY=your-key-here
# Optional — which Gemini model the planner uses. Defaults to gemini-3-flash-preview.
# Set gemini-3.1-flash-lite for the stable, lighter model.
# GEMINI_MODEL=gemini-3-flash-preview
